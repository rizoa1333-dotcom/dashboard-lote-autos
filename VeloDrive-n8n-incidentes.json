      ],
      "parameters": {
        "method": "POST",
        "url": "https://deljncdcddfghfihuumd.supabase.co/rest/v1/rpc/collect_stale_whatsapp_events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {} }}",
        "options": {
          "timeout": 15000
        }
      }
    }
  ],
  "connections": {
